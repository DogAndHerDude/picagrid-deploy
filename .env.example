# scripts/setup.sh writes this file, with its secrets generated. It stays on the server: never commit it.

DOMAIN=picagrid.com
ACME_EMAIL=you@picagrid.com

# Generated. Hex only, as they end up inside URLs.
POSTGRES_PASSWORD=
KRATOS_COOKIE_SECRET=
KRATOS_CIPHER_SECRET=

# Uploaded files, generated the same way and kept in Garage by default. To use another S3 service,
# set these too. A Garage access key is GK followed by 24 hex characters.
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# S3_ENDPOINT=https://fsn1.your-objectstorage.com
# S3_PUBLIC_ENDPOINT=https://fsn1.your-objectstorage.com
# S3_REGION=fsn1
# S3_BUCKET=picagrid

# Who can make an account without an invite. The first person to sign in has to be here.
SIGNUP_ALLOWED_EMAILS=you@picagrid.com

# Mail. A real provider: the server can't send it reliably itself.
SMTP_ADDR=smtp.example.com:587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=invites@picagrid.com
# The same login, for Kratos, with the username and password URL-encoded.
KRATOS_SMTP_URI=smtp://user:password@smtp.example.com:587/

# Sign-in providers. Callback addresses are in the README.
OIDC_PROVIDERS='[{"id":"google","provider":"google","label":"Google","client_id":"...","client_secret":"...","mapper_url":"file:///etc/config/kratos/prod/oidc.google.jsonnet","scope":["openid","email","profile"]}]'

# Company SSO, if any. See api/internal/config.
SSO_DEFAULT_PROVIDER=
SSO_DOMAINS=

# Set by scripts/rollback.sh to stay on one build. Empty follows main.
API_TAG=
UI_TAG=
WEBSITE_TAG=
KRATOS_TAG=

# Optional. Where nightly backups are also copied, like u1234@u1234.your-storagebox.de:picagrid
BACKUP_RSYNC_TARGET=
# Optional. Gets a POST with a short message when a deploy fails or a backup does.
ALERT_WEBHOOK_URL=
